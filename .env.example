# Copy to .env (never commit it). Paper mode needs none of these keys.
BTCBOT_MODE=paper              # paper | live
BTCBOT_CAPITAL=100             # paper starting balance (USD)
# --- live only ---
# CDP API key with "trade" permission only (NO transfer permission), IP allow-listed, ECDSA.
COINBASE_API_KEY=organizations/xxx/apiKeys/yyy
COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"
BTCBOT_MAX_NOTIONAL=110        # hard cap per entry order (USD)
# BTCBOT_CONFIRM_LIVE=I_UNDERSTAND   # required to place real orders
# Kraken Pro (BTCBOT_EXCHANGE=kraken): key with "Query funds" and "Query/Create/Cancel orders" only — NO withdraw.
KRAKEN_API_KEY=your-kraken-api-key
KRAKEN_API_SECRET=your-kraken-private-key-base64
# BTCBOT_ALLOW_WITHDRAW=1 plus KRAKEN_WITHDRAW_KEY=<bank name in Kraken> enable the UI's withdraw command (off by default)
